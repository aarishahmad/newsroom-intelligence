    "cors": "^2.8.5",
    "helmet": "^8.1.0",
    "express-rate-limit": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "multer": "^2.0.2",
    "cloudinary": "^2.7.0",
    "socket.io": "^4.8.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "supertest": "^7.1.4"
  }
}
